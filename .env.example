# Fire & Rescue Command System — environment configuration
# Copy this file to ".env" and fill in real values:  cp .env.example .env
# The app runs fine without a .env (sensible defaults are used), but you should
# set a real SECRET_KEY for anything other than local development.

# Flask session signing / CSRF. REQUIRED in production — use a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database connection. Defaults to a local SQLite file if unset.
# For PostgreSQL:  postgresql://user:password@localhost:5432/firedb
DATABASE_URL=sqlite:///database.db

# OpenWeatherMap API key for live weather at incident locations.
# OPTIONAL — if unset or left as the placeholder, the app returns mock weather
# data so the feature still works in a demo. Get a free key at openweathermap.org.
WEATHER_API_KEY=00000000000000000000000000000000

# Note: OSRM road routing and Nominatim geocoding need NO key — they use the
# free public OpenStreetMap services.
